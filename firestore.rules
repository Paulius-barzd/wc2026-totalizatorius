rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // === HELPER FUNKCIJOS ===

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuth() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function matchExists(matchId) {
      return exists(/databases/$(database)/documents/matches/$(matchId));
    }

    function matchStatus(matchId) {
      return get(/databases/$(database)/documents/matches/$(matchId)).data.status;
    }

    // Rungtynių kickoff'as kaip epoch milliseconds (skaičius).
    // Pildomas seed/sync metu. Senuose įrašuose gali nebūti - tada laiko patikra praleidžiama
    // (fallback'as į status patikrą, kuri vis tiek aktyvi).
    function hasKickoffMs(matchId) {
      return 'kickoffMs' in get(/databases/$(database)/documents/matches/$(matchId)).data;
    }

    function matchKickoffMs(matchId) {
      return get(/databases/$(database)/documents/matches/$(matchId)).data.kickoffMs;
    }

    function beforeKickoff(matchId) {
      return !hasKickoffMs(matchId) ||
             request.time < timestamp.value(matchKickoffMs(matchId));
    }

    function isValidScore(v, maxVal) {
      return v is int && v >= 0 && v <= maxVal;
    }

    function isReasonableString(v, maxLen) {
      return v is string && v.size() <= maxLen;
    }

    // === USERS (public profilio dalis) ===
    // Vieša info: username, avatar, company info, isAdmin
    // PRIVATU (kitur): email, fullName - users_private kolekcijoje

    match /users/{userId} {
      // Visi prisijungę gali skaityti profilius (reikalinga lyderlentei)
      allow read: if isAuth();

      // Tik vartotojas gali sukurti SAVO profilį.
      // Field allowlist + isAdmin must be false + uid must match path.
      allow create: if isOwner(userId) &&
                       request.resource.data.keys().hasOnly([
                         'uid', 'username', 'avatarLetter', 'avatarColor',
                         'companyId', 'companyName', 'companyCode',
                         'isAdmin', 'createdAt'
                       ]) &&
                       request.resource.data.isAdmin == false &&
                       request.resource.data.uid == userId &&
                       isReasonableString(request.resource.data.username, 50) &&
                       request.resource.data.username.size() >= 3;

      // Owner update: griežtai apriboti - tik avatarColor ir avatarLetter gali keisti.
      // Username NEKEIČIAMAS (impersonation prevention).
      // company* / isAdmin / createdAt / uid - immutable.
      allow update: if isOwner(userId) &&
                       request.resource.data.keys().hasOnly([
                         'uid', 'username', 'avatarLetter', 'avatarColor',
                         'companyId', 'companyName', 'companyCode',
                         'isAdmin', 'createdAt'
                       ]) &&
                       request.resource.data.uid == resource.data.uid &&
                       request.resource.data.username == resource.data.username &&
                       request.resource.data.companyId == resource.data.companyId &&
                       request.resource.data.companyName == resource.data.companyName &&
                       request.resource.data.companyCode == resource.data.companyCode &&
                       request.resource.data.isAdmin == resource.data.isAdmin &&
                       request.resource.data.createdAt == resource.data.createdAt;

      // Admin gali keisti kitų vartotojų isAdmin/company - bet vis tiek su field allowlist
      allow update: if isAdmin() &&
                       request.resource.data.keys().hasOnly([
                         'uid', 'username', 'avatarLetter', 'avatarColor',
                         'companyId', 'companyName', 'companyCode',
                         'isAdmin', 'createdAt'
                       ]) &&
                       request.resource.data.uid == resource.data.uid;

      // Owner gali ištrinti savo paskyrą (GDPR "right to erasure")
      // Admin taip pat gali ištrinti bet kokią paskyrą
      allow delete: if isOwner(userId) || isAdmin();
    }

    // === USERNAMES (unikalūs vartotojų vardai) ===
    // Kiekvienas dokumentas - rezervacija: doc.id = username.toLowerCase().trim(), data = { uid }.
    // Firestore atominis per-dokumento create garantuoja, kad du vartotojai negali užregistruoti
    // to paties vardo (net jei abu bandys tuo pat metu).

    match /usernames/{usernameLower} {
      // Viešas skaityti - reikalinga anti-collision patikrai PRIEŠ registraciją (kai dar nėra auth)
      allow read: if true;

      // Kurti gali tik autentifikuotas vartotojas, ir tik su savo uid.
      // Atominis Firestore unique key constraint užtikrina, kad rasta race condition'ai 1 laimi.
      allow create: if isAuth() &&
                       request.resource.data.keys().hasOnly(['uid']) &&
                       request.resource.data.uid == request.auth.uid;

      // Update - nekeičiamos
      allow update: if false;
      // Delete - tik tuo atveju, kai vartotojas trina savo paskyrą.
      // Patikrina, ar dabartinis auth user'is yra rezervacijos savininkas (uid sutampa).
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
    }

    // === USERS_PRIVATE (privatūs PII duomenys) ===

    match /users_private/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId) &&
                       request.resource.data.keys().hasOnly(['uid', 'email', 'fullName', 'createdAt', 'migratedAt', 'policyConsent']) &&
                       request.resource.data.uid == userId &&
                       (request.resource.data.email == null ||
                        isReasonableString(request.resource.data.email, 320)) &&
                       (request.resource.data.fullName == null ||
                        isReasonableString(request.resource.data.fullName, 200));

      allow update: if (isOwner(userId) || isAdmin()) &&
                       request.resource.data.keys().hasOnly(['uid', 'email', 'fullName', 'createdAt', 'migratedAt', 'policyConsent']) &&
                       request.resource.data.uid == resource.data.uid &&
                       (request.resource.data.email == null ||
                        isReasonableString(request.resource.data.email, 320)) &&
                       (request.resource.data.fullName == null ||
                        isReasonableString(request.resource.data.fullName, 200));

      // Owner gali ištrinti savo PII duomenis (GDPR "right to erasure")
      allow delete: if isOwner(userId) || isAdmin();
    }

    // === COMPANIES ===

    match /companies/{companyId} {
      allow read: if true;

      allow create: if isAdmin() &&
                       request.resource.data.keys().hasOnly(['name', 'code', 'createdAt']) &&
                       isReasonableString(request.resource.data.name, 100) &&
                       (request.resource.data.code == null ||
                        isReasonableString(request.resource.data.code, 6));

      allow update: if isAdmin() &&
                       request.resource.data.keys().hasOnly(['name', 'code', 'createdAt']) &&
                       isReasonableString(request.resource.data.name, 100) &&
                       (request.resource.data.code == null ||
                        isReasonableString(request.resource.data.code, 6));

      allow delete: if isAdmin();
    }

    // === MATCHES ===
    // Admin only - mažiau griežtas field check, nes admin'as turi platų valdymą

    match /matches/{matchId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // === PREDICTIONS ===
    // SVARBU dėl leaderboard'o:
    // Branch 3 (resource.data.revealed == true) leidžia ne-admin'ams query'inti
    // visas pasibaigusių/vyksta rungtynių prognozes per `where('revealed', '==', true)`.
    // Cron'as set'ina revealed=true visoms predictions, kai jų match pereina iš
    // 'upcoming' į 'live'/'finished' (žr. netlify/functions/sync-results-cron.js).
    // Tai būtina, nes Firestore Rules query'iams reikalauja STATIŠKAI patenkinamos
    // sąlygos — `get()` ant matches kolekcijos neveikia listenToCollection užklausoje.

    match /predictions/{predId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        resource.data.revealed == true
      );

      allow create: if isOwner(request.resource.data.userId) &&
                       matchExists(request.resource.data.matchId) &&
                       matchStatus(request.resource.data.matchId) == 'upcoming' &&
                       beforeKickoff(request.resource.data.matchId) &&
                       request.resource.data.keys().hasOnly(['userId', 'matchId', 'home', 'away', 'submittedAt']) &&
                       isValidScore(request.resource.data.home, 20) &&
                       isValidScore(request.resource.data.away, 20);

      // Owner gali keisti TIK home/away/submittedAt. `revealed` ir kiti laukai neperžengia.
      // Naudojam diff().affectedKeys() vietoje hasOnly, kad galėtų egzistuoti revealed
      // laukas po cron reveal'o (nors update vis tiek tik kai status='upcoming').
      allow update: if isOwner(resource.data.userId) &&
                       matchStatus(resource.data.matchId) == 'upcoming' &&
                       beforeKickoff(resource.data.matchId) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['home', 'away', 'submittedAt']) &&
                       isValidScore(request.resource.data.home, 20) &&
                       isValidScore(request.resource.data.away, 20);

      // Admin'as gali set'inti TIK `revealed` lauką iš false → true. Naudojama admin'o
      // rankinio sync'o metu (kai cron'o nesilaukia), kad leaderboard'as iškart atsinaujintų.
      // Negali grįžti atgal į false; negali keisti kitų laukų.
      allow update: if isAdmin() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revealed']) &&
                       request.resource.data.revealed == true;

      // Trinti gali admin'as IR savininkas (paskyros ištrynimo metu - GDPR)
      allow delete: if isAdmin() || isOwner(resource.data.userId);
    }

    // === SYSTEM (tarnybinė meta-info) ===
    // Cron'as saugo backfill statusą (kada paskutinį kartą buvo padaryta revealed
    // backfill migracija). Skaityti gali tik admin'as; rašyti — niekas iš kliento
    // (tik Admin SDK iš Netlify funkcijų, kuris apeina rules).

    match /system/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // === TOURNAMENT RESULTS ===

    match /tournamentResults/{resultId} {
      allow read: if isAuth();
      allow write: if isAdmin() &&
                      request.resource.data.keys().hasOnly([
                        'champion', 'bestPlayer', 'topScorer', 'bestGoalkeeper', 'bestYoungPlayer', 'updatedAt'
                      ]) &&
                      (request.resource.data.champion == null ||
                       isReasonableString(request.resource.data.champion, 10)) &&
                      isReasonableString(request.resource.data.bestPlayer, 200) &&
                      isReasonableString(request.resource.data.topScorer, 200) &&
                      isReasonableString(request.resource.data.bestGoalkeeper, 200) &&
                      isReasonableString(request.resource.data.bestYoungPlayer, 200);
    }

    // === TOURNAMENT BETS ===

    match /tournamentBets/{userId} {
      allow read: if isAuth();

      allow create: if isOwner(userId) &&
                       request.resource.data.keys().hasOnly([
                         'userId', 'champion', 'bestPlayer', 'topScorer', 'bestGoalkeeper', 'bestYoungPlayer', 'submittedAt'
                       ]) &&
                       request.resource.data.userId == userId &&
                       request.time < timestamp.date(2026, 6, 11) + duration.value(19, 'h') &&
                       (request.resource.data.champion == null ||
                        isReasonableString(request.resource.data.champion, 10)) &&
                       isReasonableString(request.resource.data.bestPlayer, 200) &&
                       isReasonableString(request.resource.data.topScorer, 200) &&
                       isReasonableString(request.resource.data.bestGoalkeeper, 200) &&
                       isReasonableString(request.resource.data.bestYoungPlayer, 200);

      allow update: if isOwner(userId) &&
                       request.resource.data.keys().hasOnly([
                         'userId', 'champion', 'bestPlayer', 'topScorer', 'bestGoalkeeper', 'bestYoungPlayer', 'submittedAt'
                       ]) &&
                       request.resource.data.userId == userId &&
                       request.time < timestamp.date(2026, 6, 11) + duration.value(19, 'h') &&
                       (request.resource.data.champion == null ||
                        isReasonableString(request.resource.data.champion, 10)) &&
                       isReasonableString(request.resource.data.bestPlayer, 200) &&
                       isReasonableString(request.resource.data.topScorer, 200) &&
                       isReasonableString(request.resource.data.bestGoalkeeper, 200) &&
                       isReasonableString(request.resource.data.bestYoungPlayer, 200);

      // Owner gali ištrinti savo turnyro prognozes (paskyros ištrynimo metu - GDPR)
      allow delete: if isOwner(userId) || isAdmin();
    }

    // === AUDIT LOG ===
    // Append-only žurnalas svarbiems admin veiksmams.
    // Skaityti gali tik admin'ai (jautri info - kas ką darė).

    match /audit_log/{logId} {
      // Tik admin'as gali skaityti istoriją
      allow read: if isAdmin();

      // Įrašyti gali tik admin'as, ir tik su savo uid kaip actor.
      // Tikrinamas griežtas field allowlist + actorUid validacija.
      allow create: if isAdmin() &&
                       request.resource.data.keys().hasOnly([
                         'actorUid', 'action', 'targetId', 'details', 'timestamp'
                       ]) &&
                       request.resource.data.actorUid == request.auth.uid &&
                       isReasonableString(request.resource.data.action, 100) &&
                       (request.resource.data.targetId == null ||
                        isReasonableString(request.resource.data.targetId, 200));

      // Žurnalas nekeičiamas ir netrinasi - append-only
      allow update, delete: if false;
    }
  }
}
